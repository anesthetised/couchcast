# Copy to .env and adjust. Everything has a development default except
# COUCHCAST_MEDIA_TOKEN_SECRET, which production must set explicitly.

# --- infrastructure (compose) ---
POSTGRES_USER=couchcast
POSTGRES_PASSWORD=couchcast
POSTGRES_DB=couchcast
MINIO_ROOT_USER=couchcast
MINIO_ROOT_PASSWORD=couchcast-dev-secret
S3_BUCKET=couchcast

# --- ports published on the host (dev) ---
WEB_PORT=8080
FRONTEND_PORT=5173
POSTGRES_PORT=5432
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
INGEST_METRICS_PORT=9090

# --- application ---
COUCHCAST_LOG_LEVEL=debug
COUCHCAST_SECURE_COOKIES=false
# openssl rand -hex 32
COUCHCAST_MEDIA_TOKEN_SECRET=
COUCHCAST_INGEST_WORKERS=2
# Register/login attempts per minute per client IP
COUCHCAST_AUTH_RATE_PER_MINUTE=10
# Use X-Forwarded-For for rate limiting (only behind a proxy that sets it)
COUCHCAST_TRUST_PROXY=false
# Extra yt-dlp flags, e.g. --cookies /run/secrets/cookies.txt
COUCHCAST_YTDLP_EXTRA_ARGS=
# Web Push (optional): `couchcast vapid` prints a key pair; the subject is
# a contact for push services (mailto: or https:)
COUCHCAST_VAPID_PUBLIC_KEY=
COUCHCAST_VAPID_PRIVATE_KEY=
COUCHCAST_VAPID_SUBJECT=

# --- image tag for `just build` / `just prod-up` ---
TAG=dev
